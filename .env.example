POSTGRES_PASSWORD=replace-with-a-long-alphanumeric-secret
SESSION_SECRET=replace-with-at-least-32-random-characters
DRAW_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
APP_URL=http://localhost:3000

# Local verification email is captured by Mailpit at http://localhost:8025.
# For deployment, replace these with your authenticated SMTP provider.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Fair Drop <no-reply@fairdrop.local>

# Set true only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
POW_DIFFICULTY_BITS=16
PG_POOL_MAX=20
DRAW_WORKER_CONCURRENCY=2
